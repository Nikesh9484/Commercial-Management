# Copy this file to ".env" and change the values if you want.
# Everything has a sensible default, so the app runs even without a .env file.

# Secret used to sign login cookies. Change this to any long random text.
SESSION_SECRET=change-me-to-a-long-random-sentence

# First admin account (created only the very first time the app starts)
ADMIN_EMAIL=admin@commercial.local
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Commercial Manager

# Forgot the admin password? Set ADMIN_RESET to a new value (e.g. 1) with ADMIN_EMAIL / ADMIN_PASSWORD
# and restart: that user becomes an active Admin with that password. Applied once per value.
# ADMIN_RESET=1

# Where the database file lives (default: ./data/commercial.db)
# DB_PATH=./data/commercial.db

# Cloud backup of the database (needed on hosting services whose disk is wiped on restart).
# Option 1 – a private GitHub repository (used by the Render setup):
# BACKUP_GITHUB_REPO=Nikesh9484/Commercial-Management-data
# BACKUP_GITHUB_TOKEN=github_pat_...   (fine-grained token, Contents: read & write on that repo)
# Option 2 – any S3-compatible storage (Backblaze B2, Cloudflare R2, AWS S3 …):
# BACKUP_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# BACKUP_S3_REGION=us-west-004
# BACKUP_S3_BUCKET=my-bucket-name
# BACKUP_S3_KEY_ID=...
# BACKUP_S3_SECRET=...

# Automation → Claim EAR (Employer's Assessment Report). The report is written by Claude; without
# the key the page still stores the documents and produces a skeleton from your template.
# ANTHROPIC_API_KEY=sk-ant-...
# EAR_MODEL=claude-opus-5
