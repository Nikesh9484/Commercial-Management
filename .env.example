# Copy this file to ".env" and change the values if you want.
# Everything has a sensible default, so the app runs even without a .env file.

# Secret used to sign login cookies. Change this to any long random text.
SESSION_SECRET=change-me-to-a-long-random-sentence

# First admin account (created only the very first time the app starts)
ADMIN_EMAIL=admin@commercial.local
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Commercial Manager

# Where the database file lives (default: ./data/commercial.db)
# DB_PATH=./data/commercial.db
